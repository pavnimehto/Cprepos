#include <stdio.h>
int main()
{
    int i, n, z=0, count=0;
    printf("Enter a number of your choice:");
    scanf("%d", &n);
    int arr[n];
    for (i=1; i<=n; i++)
    {
        if (n%i==0)
        { arr[count] = i;
        count++;
        }
        else 
        {continue;}
    }
    while (z<count)
    {
        printf(" %d,", arr[z]);
        z++;
    }
}
