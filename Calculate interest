#include <stdio.h>

int main() {
    double P, R, N, I;

    printf("Enter Principal amount (P): ");
    scanf("%lf", &P);

    printf("Enter Rate of interest (R): ");
    scanf("%lf", &R);

    printf("Enter Time period in years (N): ");
    scanf("%lf", &N);

    I = (P * R * N) / 100;

    printf("Simple Interest = %.2lf\n", I);

    return 0;
}
