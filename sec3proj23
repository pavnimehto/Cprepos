#include <stdio.h>
#include <string.h>
int main()
{
    int i, per, sum=0;
    char num[100];
    printf("Enter your number:");
    scanf("%s", num);
    for (i=0; i< strlen(num); i++)
    {
        per = num[i] - '0';
        sum+= per;

    }
    printf("The sum of the digits of this number is %d", sum);
    
}
