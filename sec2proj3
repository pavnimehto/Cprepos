#include <stdio.h>
int main()
{
    float netSalary, grossSalary;
    printf("Enter Gross Salary:");
    scanf("%f", &grossSalary);
    if (grossSalary>10000)
    {
        netSalary = grossSalary + grossSalary*0.1 - grossSalary*0.03;
    }
    else if (grossSalary>5000)
    {
        netSalary = grossSalary + grossSalary*0.07 - grossSalary*0.02;
    }
    printf("%.2f is the Net Salary", netSalary);
}
