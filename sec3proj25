#include<stdio.h>
#include<string.h>
int main()

{
    int i, n, f;
    char nuM[100];
    printf("Enter a number to verify:");
    scanf("%s", nuM);
    n = strlen(nuM);
    for (i=0; i<n; i++)
    {
        if (nuM[i]==nuM[(n-1)-i])
        {f=1;
        }
        else 
        {f=3;
        break;}
    }
    if (f==1)
    {printf("Given number is a palindrome");
    }
    else 
    {printf("Given number is not a palindrome");
    }

}
