#include <stdio.h>
int main()
{
    int i, n=13, sum=0;
    for (i=1; i<=100; i++)
    {//here the division and reaminder check belongs inside the code because otherwise the code wont even run once because 1 divided by 13 is not zero so it breaks out of loop on the first iteration itself//
        if (i%n==0)
        {sum= sum + i;
        }
        else
        {continue;}
    }
    printf("%d", sum);

}
