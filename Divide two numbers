#include <stdio.h>

int main() {
    double num1, num2, quotient;

    printf("Enter first number (dividend): ");
    scanf("%lf", &num1);

    printf("Enter second number (divisor): ");
    scanf("%lf", &num2);

    if (num2 == 0) {
        printf("Error: Division by zero is not allowed.\n");
        return 1;
    }

    quotient = num1 / num2;

    printf("Quotient = %.2lf\n", quotient);

    return 0;
}
