#include <stdio.h>

int main() {
    double a, b, temp;

    printf("Enter value of a: ");
    scanf("%lf", &a);

    printf("Enter value of b: ");
    scanf("%lf", &b);

    printf("Before swapping: a = %.2lf, b = %.2lf\n", a, b);

    temp = a;
    a = b;
    b = temp;

    printf("After swapping: a = %.2lf, b = %.2lf\n", a, b);

    return 0;
}

