#include <stdio.h>
int main()
{
    float marks1, marks2, marks3, average, total;
    
    printf("Enter marks of first subject:");
    scanf("%f", &marks1);
    printf("Enter marks of second subject:");
    scanf("%f", &marks2);
    printf("Enter marks of third subject:");
    scanf("%f", &marks3);
    total = (float)(marks1 + marks2 + marks3);
    average = (float)total/3.0;

    printf("Total marks = %.2f\n", total);
    printf("Average marks = %.2f\n", average);

    if (marks1<35 || marks2<35 || marks3<35)
    {printf("Fail");
    }
    else if (average >= 70)
    {printf("Distinction");
    }
    else if (average >= 60)
    {printf("First");
    }
    else if (average >=50)
    {printf("Second");
    }
    else if (average >= 35)
    {printf("Third class");
    }
    else
    {printf("Fail");
    }
    
}
