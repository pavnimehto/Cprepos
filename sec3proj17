#include <stdio.h>
int main ()
{
    int arr[200], i, positive=0, negative =0, zero =0;
    printf("Enter 200 values:");
    for (i=0; i<200; i++)
    {
        scanf("%d", &arr[i]);
        if (arr[i]>0)
        {positive = positive +1;
        }
        else if (arr[i]<0)
        {negative = negative +1;
        }
        else 
        {zero= zero + 1;
        }
    }
    printf("Number of positive entries = %d\n", positive);
    printf("Number of negative entries = %d\n", negative);
    printf("Number of zero entries = %d", zero);

}
